# Copy to .env.local for local development.
# Leave both blank to use the offline IndexedDB backend (single player, no setup).

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=
# Public anon key from Project Settings -> API. Safe to ship in the bundle (RLS enforced).
VITE_SUPABASE_ANON_KEY=

# Vite base path. Use "/repo-name/" for GitHub Pages project sites, "/" for root hosting.
VITE_BASE_PATH=/
